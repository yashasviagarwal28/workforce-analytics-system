# Python-generated files
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/

# Environment variables and secrets
.env

# macOS files
.DS_Store

# Test and tooling caches
.pytest_cache/
.coverage
htmlcov/

# Generated project data
data/raw/*
data/processed/*

# Keep empty data directories
!data/raw/.gitkeep
!data/processed/.gitkeep
cat >> .gitignore <<'EOF'

# Generated workforce data
data/raw/*.csv
data/processed/*.parquet

# Trained model and evaluation outputs
artifacts/
*.joblib

# Local databases
*.db
*.sqlite
*.sqlite3

# Local backups and caches
src-backup/
__pycache__/
*.py[cod]
.pytest_cache/
EOF